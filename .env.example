# InfluxDB 1.x connection (point at your existing container on the LAN)
INFLUX_HOST=192.168.1.10
INFLUX_PORT=8086
INFLUX_DATABASE=house
INFLUX_USERNAME=readonly
INFLUX_PASSWORD=changeme
INFLUX_SSL=false
INFLUX_TIMEOUT_SECONDS=10
INFLUX_ROW_LIMIT=50000

# LLM provider: "claude" (default) or "ollama"
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-5
LLM_EFFORT=high            # low | medium | high | xhigh | max  (Diep-nadenken-knop in de UI overschrijft naar 'max' per vraag)
LLM_MAX_TOKENS=64000       # 64K is veilig met streaming + adaptive thinking op de huidige modellen
LLM_MAX_AGENT_STEPS=12     # safety cap on tool-use iterations per question

# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Used when LLM_PROVIDER=ollama (e.g. running on a Raspberry Pi 5)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# State (chats, pins, schema annotations)
STATE_DB_PATH=./data/state.db
RESULTS_TTL_SECONDS=3600

API_HOST=0.0.0.0
API_PORT=8000
